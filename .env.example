# Environment variables for the ServiceNowSecOps MCP server
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control!

# ServiceNow instance: a bare name ("acme"), a host, or a URL
SERVICENOW_INSTANCE_URL="https://your-instance.service-now.com"

# OAuth client registered in ServiceNow with the client_credentials grant enabled
# and bound to the dedicated service account (the "OAuth Application User").
SERVICENOW_CLIENT_ID=""
SERVICENOW_CLIENT_SECRET=""
